{
  "name": "pixel-surgeon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 127.0.0.1 --port 4203 --strictPort",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "demo": "node scripts/tasks.mjs demo",
    "check": "npm run build && npm run test && npm run e2e",
    "browser:install": "node scripts/tasks.mjs browser",
    "setup": "node scripts/tasks.mjs setup",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "react": "*",
    "react-dom": "*",
    "express": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@playwright/test": "*",
    "@types/express": "*",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@vitejs/plugin-react": "*",
    "concurrently": "*",
    "tsx": "*",
    "typescript": "*",
    "vite": "*",
    "vitest": "*"
  }
}
